POSTGRES_DB=data_quality
POSTGRES_USER=data_quality
POSTGRES_PASSWORD=change-me-for-non-local-use
DATABASE_URL=postgresql+psycopg://data_quality:change-me-for-non-local-use@db:5432/data_quality
STORAGE_ROOT=/data/storage
MASTER_REFERENCE_PATH=/app/reference/master.csv
MAX_UPLOAD_MB=25
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=1000
MAX_DATASET_CELLS=2000000
MAX_FINDINGS=10000
PREVIEW_ROWS=50
CORS_ORIGINS=http://localhost:5173
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-with-server-side-secret
LLM_MODEL=main-model
LLM_MAX_CANDIDATES=50
LLM_MAX_COLUMNS=20
LLM_MAX_ACTION_GROUPS=20
LLM_TIMEOUT_SECONDS=10
AUTH_COOKIE_NAME=dq_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
